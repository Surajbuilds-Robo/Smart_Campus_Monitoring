# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/smart_campus

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:8081

# AI Edge Service Integration
AI_SERVICE_TOKEN=replace_with_a_long_random_secret

# Application & Timezone Configuration
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:5173

# Optional Email Notification Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional Push Notification Configuration (Firebase Service Account JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=
