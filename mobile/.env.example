# Smart Campus Monitoring — Mobile Environment Configuration
# Copy this file to .env in the mobile/ directory to customize settings.

# Backend API Base URL
# - iOS Simulator / Web: http://localhost:5000/api/v1
# - Android Emulator:   http://10.0.2.2:5000/api/v1
# - Physical Device:    http://<YOUR_LOCAL_IP>:5000/api/v1 (e.g., http://192.168.1.100:5000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Backend Socket.IO Server URL (optional, defaults to API URL host)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
