{
  "name": "Smart Campus Monitoring",
  "short_name": "SmartCampus",
  "description": "Real-time camera feeds, crowd density, parking availability, and incident tracking.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#020617",
  "theme_color": "#020617",
