CAMERA_SOURCE=test_video.mp4
CAMERA_ID=CAM-001

BACKEND_URL=http://localhost:5000
AI_SERVICE_TOKEN=replace_with_a_long_random_secret

PERSON_MODEL_PATH=yolov8n.pt
# Optional specialized weights for fall/violence detection (disabled if not supplied)
# EVENT_MODEL_PATH=models/fall_violence.pt
CONFIDENCE_THRESHOLD=0.35
CROWD_CAPACITY=100

# Crowd count alert threshold (default > 4 people triggers incident)
CROWD_ALERT_THRESHOLD=4

# 120 seconds = two-minute persistence check
PERSISTENCE_SECONDS=120
FRAME_SKIP=5

EVIDENCE_DIR=evidence
EVIDENCE_COUNT=4

LOG_LEVEL=INFO